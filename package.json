{
  "name": "erp",
  "private": true,
  "description": "Multi-business ERP and CRM. Generic core, industry packs. First customer: a motorcycle dealership.",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "workspaces": [
    "packages/*",
    "packages/backend/src/*",
    "tools"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --concurrency=1",
    "test:isolation": "npm run test:isolation -w @erp/api",
    "check": "npm run lint && npm run typecheck && npm run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:up": "docker compose up -d --wait",
    "docker:down": "docker compose down",
    "db:provisioner-role": "docker compose exec -T postgres sh /docker-entrypoint-initdb.d/02-provisioner-role.sh",
    "db:generate": "npm run db:generate -w @erp/dal",
    "db:migrate:dev": "npm run db:migrate:dev -w @erp/dal",
    "db:migrate:new": "npm run db:migrate:new -w @erp/dal --",
    "db:migrate:deploy": "npm run db:migrate:deploy -w @erp/dal",
    "db:migrate:check": "npm run db:migrate:check -w @erp/dal",
    "db:studio": "npm run db:studio -w @erp/dal",
    "db:seed": "npm run db:seed -w @erp/business-logic",
    "demo:reset": "sh tools/scripts/demo-reset.sh",
    "demo:start": "sh tools/scripts/demo-start.sh",
    "demo:seed": "sh tools/scripts/demo-seed.sh"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "jsdom": "29.1.1",
    "prettier": "3.10.1",
    "turbo": "2.11.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
