# Copy to .env (`cp .env.example .env`). .env is gitignored; never commit it, never paste it into a
# Claude session. Every value here is a local-development placeholder, not a real secret.

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# --- API / web -------------------------------------------------------------
API_PORT=3000
WEB_PORT=5173
# Where the Vite dev server proxies /api requests. 127.0.0.1, not localhost: localhost can resolve to IPv6
# ::1, where another local server may be listening on the same port.
API_PROXY_TARGET=http://127.0.0.1:3000

# --- PostgreSQL (docker compose) -------------------------------------------
# 5433 on the host so it does not clash with a locally installed Postgres on 5432.
POSTGRES_PORT=5433
POSTGRES_DB=erp
# Owner role: runs migrations, owns tables. Never used by the running app.
POSTGRES_USER=erp_owner
POSTGRES_PASSWORD=erp_owner_dev
# Application role: NOSUPERUSER, NOBYPASSRLS, owns nothing. The API and worker connect as this.
APP_DB_USER=erp_app
APP_DB_PASSWORD=erp_app_dev
# Used by the API and worker.
DATABASE_URL=postgresql://erp_app:erp_app_dev@localhost:5433/erp
# Used only by Prisma migrate (owner role).
MIGRATION_DATABASE_URL=postgresql://erp_owner:erp_owner_dev@localhost:5433/erp
# Connections per api process. Each tenant request holds one for its whole transaction (ADR 0005).
DB_POOL_MAX=10
# Prisma's limit on a whole request transaction, in ms. The erp_app role's statement_timeout (5s) and
# idle_in_transaction_session_timeout (15s), set in docker/postgres/init/01-app-role.sh, are the primary limits.
DB_TX_TIMEOUT_MS=10000

# --- Redis (queues, cache, rate limits) ------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Object storage (MinIO, S3 compatible) ---------------------------------
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=erp-dev
S3_ACCESS_KEY=erp_minio
S3_SECRET_KEY=erp_minio_dev

# --- Email (Mailpit catches everything; UI on MAILPIT_UI_PORT) -------------
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAIL_FROM=no-reply@erp.local
